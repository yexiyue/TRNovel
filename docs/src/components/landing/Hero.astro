---
import { Image } from 'astro:assets';
import companion from '../../../../assets/brand/mascot-xiaojuan.png';
---

<section class="tn-hero" aria-labelledby="_top">
  <div class="copy">
    <p class="eyebrow">TRNOVEL / TERMINAL NOVEL READER</p>
    <h1 id="_top">打开终端，<br />走进<span>故事。</span></h1>
    <p class="sub">本地小说、网络书源、断点续读。<br />用熟悉的键盘，读下一章。</p>
    <div class="actions">
      <a class="tn-button" href="#30-秒上手">安装 TRNovel <span aria-hidden="true">↗</span></a>
      <a class="preview-link" href="#看它跑起来">先看看怎么读 <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <div class="companion">
    <Image src={companion} width={480} height={480} widths={[320, 480, 720]} sizes="(min-width: 960px) 420px, 80vw" alt="终端机器人小卷向你挥手，屏幕上亮着橙色命令行表情" loading="eager" fetchpriority="high" />
  </div>
</section>

<style>
  .tn-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: 3.5rem 2rem;
  }
  .eyebrow {
    margin: 0 0 1.5rem;
    font: 0.7rem var(--tn-mono);
    letter-spacing: 0.08em;
    color: var(--tn-muted);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 5.5vw, 4.8rem);
    line-height: 1.14;
    letter-spacing: -0.05em;
    color: var(--tn-ink);
  }
  h1 span {
    color: var(--tn-accent);
  }
  .sub {
    margin: 1.6rem 0 0;
    font-size: 1.1rem;
    line-height: 1.9;
    color: var(--tn-muted);
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .preview-link {
    display: inline-flex;
    gap: 0.75rem;
    padding-block: 0.8rem;
    color: var(--tn-ink);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .preview-link:hover {
    color: var(--tn-accent);
  }
  .companion {
    display: grid;
    place-items: center;
    background: var(--tn-surface);
    border-radius: 2px 72px 2px 2px;
    border-bottom: 3px solid var(--tn-accent);
  }
  .companion img {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
  }
  @media (max-width: 767px) {
    .tn-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2rem 0;
    }
    h1 {
      font-size: clamp(2.7rem, 10vw, 4rem);
    }
    .sub {
      font-size: 1rem;
      margin-top: 1.2rem;
    }
    .actions {
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
    .companion {
      max-width: 420px;
      width: 100%;
      justify-self: center;
      border-radius: 2px 48px 2px 2px;
    }
    .companion img {
      max-width: 300px;
    }
  }
</style>
