---
import { Image } from "astro:assets";
import companion from "../../../../assets/brand/mascot-reading.png";

const base = "/TRNovel";
---

<section class="tn-hero">
	<div class="copy">
		<p class="eyebrow">TRNOVEL / TERMINAL NOVEL READER</p>
		<h1>打开终端，<br />走进<span class="accent">故事。</span></h1>
		<p class="sub">
			本地 TXT、网络书源、断点续读。用键盘翻页，读累了，就让终端伙伴小卷陪你听下一章。
		</p>
		<div class="actions">
			<a class="btn primary" href={`${base}/guides/intro/`}>开始阅读 <span aria-hidden="true">↗</span></a>
			<a class="btn ghost" href="https://github.com/yexiyue/TRNovel">GitHub</a>
		</div>
		<button class="install" type="button" data-cmd="cargo install trnovel" aria-label="复制安装命令：cargo install trnovel">
			<code><span class="prompt">$</span> cargo install trnovel</code>
			<span class="hint" data-idle>复制</span>
			<span class="hint" data-done>已复制</span>
		</button>
	</div>
	<figure class="companion">
		<div class="terminal-label"><span aria-hidden="true">&gt;_</span> trn -q <span class="cursor" aria-hidden="true"></span></div>
		<Image src={companion} width={520} height={520} widths={[320, 520, 800]} sizes="(min-width: 960px) 480px, (min-width: 600px) 520px, 85vw" alt="小卷：捧着一本书的方形终端机器人，屏幕上是橙色命令行表情" loading="eager" fetchpriority="high" />
		<figcaption><strong>小卷，终端里的故事伙伴。</strong><span>从上次的位置，继续下一页。</span></figcaption>
	</figure>
</section>

<script>
	for (const btn of document.querySelectorAll<HTMLButtonElement>(".install")) {
		btn.addEventListener("click", async () => {
			const cmd = btn.dataset.cmd;
			if (!cmd) return;
			try {
				await navigator.clipboard.writeText(cmd);
				btn.classList.add("copied");
				setTimeout(() => btn.classList.remove("copied"), 1600);
			} catch {
				/* The visible command remains selectable when the clipboard is unavailable. */
			}
		});
	}
</script>

<style>
	.tn-hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		padding-block: 3rem 1.5rem;
	}
	.eyebrow {
		margin: 0 0 1.5rem;
		font-family: var(--tn-mono);
		font-size: 0.7rem;
		letter-spacing: 0.09em;
		color: var(--sl-color-gray-3);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 5.5vw, 4.3rem);
		line-height: 1.18;
		letter-spacing: -0.04em;
		font-weight: 750;
		color: var(--sl-color-white);
	}
	.accent { color: var(--tn-accent); }
	.sub {
		margin: 1.5rem 0 0;
		max-width: 29em;
		font-size: 1.05rem;
		line-height: 1.85;
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 1.5rem;
		padding: 0.7rem 1.25rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}
	.btn.primary {
		background: var(--tn-accent);
		color: var(--tn-accent-contrast);
	}
	.btn.primary:hover { background: color-mix(in srgb, var(--tn-accent) 90%, var(--sl-color-white)); }
	.btn.ghost {
		border: 1px solid var(--tn-border);
		color: var(--sl-color-white);
	}
	.btn.ghost:hover, .install:hover { border-color: var(--tn-accent); }
	.btn:focus-visible, .install:focus-visible {
		outline: 2px solid var(--tn-accent);
		outline-offset: 4px;
	}
	.install {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		max-width: 100%;
		margin-top: 1.25rem;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--tn-border);
		border-radius: 8px;
		background: var(--tn-surface);
		cursor: pointer;
		font-family: var(--tn-mono);
		font-size: 0.8rem;
		color: var(--sl-color-white);
		transition: border-color 0.15s ease;
	}
	.install code { background: none; padding: 0; }
	.prompt { color: var(--tn-accent); margin-inline-end: 0.4em; }
	.hint { font-size: 0.7rem; color: var(--sl-color-gray-3); }
	.hint[data-done] { display: none; color: var(--tn-accent); }
	.install.copied .hint[data-idle] { display: none; }
	.install.copied .hint[data-done] { display: inline; }
	.companion {
		margin: 0;
		padding: 1.25rem 1.25rem 1.5rem;
		border: 1px solid var(--tn-border);
		border-radius: 20px;
		background: var(--tn-surface);
	}
	.terminal-label {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font: 0.8rem var(--tn-mono);
		color: var(--sl-color-gray-2);
	}
	.terminal-label > span:first-child { color: var(--tn-accent); }
	.cursor {
		width: 0.55rem;
		height: 0.75rem;
		margin-inline-start: auto;
		background: var(--tn-accent);
	}
	.companion img { display: block; width: 100%; height: auto; max-width: 480px; margin-inline: auto; }
	figcaption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--tn-border);
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	figcaption strong { font-weight: 500; color: var(--sl-color-gray-2); }
	@media (min-width: 960px) {
		.tn-hero { grid-template-columns: 1fr 1fr; gap: 4rem; padding-block: 4rem 2rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.btn, .install { transition: none; }
	}
</style>
